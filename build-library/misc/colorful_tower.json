  "generatorCode": "\n// カラフルな螺旋タワー\nconst colors = [\"r\", \"o\", \"y\", \"g\", \"b\", \"p\"];\nconst height = 12;\nconst radius = 8;\n\n// 螺旋状のブロック\nfor (let i = 0; i < height * 6; i++) {\n    const angle = (i / 6) * Math.PI * 2;\n    const y = i * 1.5;\n    const x = Math.cos(angle) * radius;\n    const z = Math.sin(angle) * radius;\n    const color = colors[i % colors.length];\n    part(x, y + 1, z, 3, 2, 3, color);\n}\n\n// 中央の柱\nfor (let y = 0; y < height * 9; y += 4) {\n    part(0, y + 2, 0, 2, 4, 2, \"w\");\n}\n\n// 頂上に光るボール\nrpart(0, height * 9 + 4, 0, 6, 6, 6, 0, 0, 0, \"n\", \"Ball\");\n"
}